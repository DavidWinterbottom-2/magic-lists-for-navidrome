# Navidrome Configuration
NAVIDROME_URL=http://navidrome:4533

# Use username/password (will login to get token)
NAVIDROME_USERNAME=your_navidrome_username
NAVIDROME_PASSWORD=your_password

# Static Navidrome API key (optional). If set, it's used instead of
# username/password. Leave empty to authenticate with the credentials above.
# NAVIDROME_API_KEY=

# Navidrome request timeout in seconds (optional). Default: 30. Raise it if
# similar-songs lookups time out on a slow server — a timeout silently thins
# the Radio pool rather than erroring.
# NAVIDROME_TIMEOUT=30

# =============================================================================
# AI Configuration
# =============================================================================

# AI Provider Selection
# Options: openrouter, groq, google, ollama
AI_PROVIDER=openrouter

# API Key (required for openrouter, groq, and google; not needed for ollama)
# - Get OpenRouter key: https://openrouter.ai/ ($5 minimum, pay-as-you-go)
# - Get Groq key: https://console.groq.com/ (FREE, no credit card required)
# - Get Google AI key: https://ai.google.dev/ (FREE, generous quota, no credit card required)
AI_API_KEY=your_api_key_here

# Model Selection (optional - defaults provided for each provider)
# OpenRouter: openai/gpt-3.5-turbo, anthropic/claude-3-haiku, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, etc.
# Groq: mixtral-8x7b-32768, llama-3.1-8b-instant, etc.
# Google: gemini-2.5-flash, gemini-1.5-pro, etc.
# Ollama: llama3.2, mistral, mixtral, etc. (must be pulled first: ollama pull llama3.2)
AI_MODEL=openai/gpt-4o-mini

# AI Base URL (optional). Override the OpenAI-compatible chat-completions
# endpoint used to reach the OpenRouter provider (e.g. a proxy or self-hosted
# gateway). Default: https://openrouter.ai/api/v1/chat/completions
# Groq and Google use their own fixed endpoints; Ollama uses OLLAMA_BASE_URL.
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Ollama Base URL (only needed if using ollama provider)
# - Running locally without Docker: http://localhost:11434/v1/chat/completions
# - MagicLists in Docker, Ollama on host: http://host.docker.internal:11434/v1/chat/completions
# - Both in same docker-compose: http://ollama:11434/v1/chat/completions
OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions

# Ollama Request Timeout (only needed if using ollama provider)
# Default: 180 seconds. Increase if you have a slow CPU or large models
# Examples: 300 (5 minutes), 600 (10 minutes), 900 (15 minutes)
OLLAMA_TIMEOUT=180

# Music Path (for Docker Compose)
MUSIC_PATH=/path/to/your/music/library

# Database Configuration
# For Docker: use /app/data/magiclists.db (mounted volume)
# For local development: use ./magiclists.db (current directory)
DATABASE_PATH=/app/data/magiclists.db

# Logging Configuration (ERROR=minimal, INFO=normal, DEBUG=verbose)
LOG_LEVEL=INFO

# Port the app listens on (optional). Default: 4545. Change it if 4545 clashes
# with another service; update your published port / reverse proxy to match.
# PORT=4545

# Set the ID of the Navidrome library to use (optional)
# Leave empty to use the default library
NAVIDROME_LIBRARY_ID=

# Lidarr Configuration (optional)
# Base URL of your Lidarr instance. When set, the Radio album suggestions link
# straight to Lidarr's "Add New" search, prefilled with the artist and album.
# Leave empty to render the suggestions as plain text.
# Example: https://lidarr.example.com
LIDARR_URL=


# Last.fm Configuration (optional)
# When set, MagicLists reads your Last.fm data directly to sharpen curation —
# starting with your loved tracks, which get a boost in every playlist's scoring.
# Leave LASTFM_API_KEY empty to disable; everything degrades to Navidrome-only.
#
# LASTFM_API_KEY: create one at https://www.last.fm/api/account/create
# LASTFM_USERNAME: your Last.fm handle. Reading your loved/top tracks needs only
#   this plus the API key (no login), as long as your profile isn't set to hide
#   its listening — Settings → Privacy → "Hide recent listening information" OFF.
LASTFM_API_KEY=
LASTFM_USERNAME=


# Deployment (optional)
# Which published image the container runs. Defaults to :latest, which is what
# Watchtower follows. Pin a specific build to roll back, e.g. sha-<commit>.
MAGICLISTS_VERSION=latest


# Analytics (optional) — Umami
# Where to report usage analytics. BOTH must be set or nothing is collected.
# Point these at an Umami instance you run; never a third party's, or your
# usage (including which AI provider and model you use) leaves the estate.
# ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
# ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000


# Authentication (Microsoft Entra ID / Azure AD OIDC)
# Magic Lists holds your Navidrome credentials and AI key server-side, so once
# it is exposed on the public internet it MUST require login. The gate is OFF by
# default (AUTH_DISABLED unset ⇒ disabled) so a trusted LAN / Tailscale
# deployment keeps working unchanged; set AUTH_DISABLED=false together with the
# Azure credentials below before making it public. Same convention as the other
# winterbottom.xyz apps, so one Azure app registration can be reused (just add
# this service's redirect URI to it).
AUTH_DISABLED=true
# AZURE_TENANT_ID=consumers                       # "consumers" for personal MS accounts, or a tenant GUID
# AZURE_CLIENT_ID=your_app_registration_client_id
# AZURE_CLIENT_SECRET=your_app_registration_client_secret
# ALLOWED_EMAILS=you@example.com                  # comma-separated allowlist; empty = any account in the tenant
# SESSION_SECRET=a_long_random_value              # signs the login cookie; set so logins survive a restart
# OIDC_REDIRECT_URI=                              # override the callback URL if proxy auto-detection is wrong
# SESSION_HTTPS_ONLY=true                         # set false only for plain-http local testing
